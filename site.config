// Load with: nextflow run main.nf -profile slurm,conda -c site.config ...
// Use Slurm's default partition and account.
// The only place CPU, memory and time are set for each process; always run with -c site.config (or your copy).
// Times are initial wall-time limits per task, not benchmarked runtimes.
process {

  // Step 01: call peaks per sample.
  withName: PEAK_SAMPLE {
    cpus = 4
    memory = '24 GB'
    time = '24h'
  }

  // Step 02: merge and filter stage peaks.
  withName: COMMON_PEAKS {
    cpus = 2
    memory = '12 GB'
    time = '24h'
  }

  // Step 03: per-cell QC metrics.
  withName: QC_METRICS {
    cpus = 4
    memory = '48 GB'
    time = '24h'
  }

  // Step 04: QC summaries and plots.
  withName: QC_REVIEW {
    cpus = 2
    memory = '12 GB'
    time = '24h'
  }

  // Step 05: review QC-passing clusters.
  withName: PRE_DOUBLET_REVIEW {
    cpus = 4
    memory = '48 GB'
    time = '24h'
  }

  // Step 06: cluster removal and DoubletFinder.
  withName: QC_FILTER_DOUBLET {
    cpus = 4
    memory = '48 GB'
    time = '48h'
  }

  // Step 07: stage RNA preprocessing and integration.
  withName: MERGE_INTEGRATE_RNA {
    cpus = 8
    memory = '96 GB'
    time = '24h'
  }

  // Step 08: stage ATAC preprocessing and integration.
  withName: MERGE_INTEGRATE_ATAC {
    cpus = 8
    memory = '96 GB'
    time = '24h'
  }

  // Step 09: extract mgatk metrics per sample.
  withName: MGATK_METRICS {
    cpus = 2
    memory = '24 GB'
    time = '24h'
  }

  // Step 10: nuclear coverage and both mtDNA copy-number estimates per sample.
  withName: MTDNA_COPY_NUMBER {
    cpus = 8
    memory = '24 GB'
    time = '48h'
  }

  // Step 12: stage WNN analysis.
  withName: WNN_STAGE {
    cpus = 8
    memory = '96 GB'
    time = '24h'
  }

  // Step 13: attach mitochondrial metrics.
  withName: ADD_MGATK {
    cpus = 2
    memory = '64 GB'
    time = '24h'
  }

  // Step 14: cluster markers.
  withName: DEG_STAGE {
    cpus = 4
    memory = '64 GB'
    time = '24h'
  }
}
