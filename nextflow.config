process {
  executor = 'local'
  errorStrategy = 'terminate'
  // Lmod startup reads unset variables, so omit Bash nounset (-u).
  shell = ['/bin/bash', '-eo', 'pipefail']
  // Limit multithreaded maths (OpenBLAS) and UMAP threads to the task's cpus from site.config.
  beforeScript = { "export OPENBLAS_NUM_THREADS=${task.cpus} OMP_NUM_THREADS=${task.cpus} RCPP_PARALLEL_NUM_THREADS=${task.cpus}" }
}

params {
  outdir = 'results'
  conda_env = null
  enable_conda = false
  // Default phase; also names the execution reports below.
  phase = 'review'
}

// Keep each stage's task work directories with its results; -w overrides this.
workDir = "${params.outdir}/${params.stage}/work"

profiles {
  conda {
    params.enable_conda = true
    conda.enabled = true
    // One pre-existing environment (or shared YAML) for every process.
    process.conda = params.conda_env
  }
  slurm {
    process.executor = 'slurm'
    // Supply cluster-specific queue/account with -c site.config.
  }
}

// Save execution diagnostics alongside results, one set per phase; a rerun of
// the same phase refreshes its own files.
report {
  enabled = true
  file = "${params.outdir}/${params.stage}/reports/execution_report_${params.phase}.html"
  overwrite = true
}

trace {
  enabled = true
  file = "${params.outdir}/${params.stage}/reports/execution_trace_${params.phase}.txt"
  overwrite = true
}

timeline {
  enabled = true
  file = "${params.outdir}/${params.stage}/reports/execution_timeline_${params.phase}.html"
  overwrite = true
}
