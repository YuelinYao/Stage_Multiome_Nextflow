process {
  executor = 'local'
  errorStrategy = 'terminate'
  // Lmod startup reads unset variables, so omit Bash nounset (-u).
  shell = ['/bin/bash', '-eo', 'pipefail']
}

params {
  outdir = 'results'
  conda_env = null
  enable_conda = false
}

profiles {
  conda {
    params.enable_conda = true
    conda.enabled = true
    // One pre-existing environment (or shared YAML) for every process.
    process.conda = params.conda_env
  }
  slurm {
    process.executor = 'slurm'
    // Supply cluster-specific queue/account with -c site.config.
  }
}

// Save execution diagnostics alongside results; refresh them on each run.
report {
  enabled = true
  file = "${params.outdir}/execution_report.html"
  overwrite = true
}

trace {
  enabled = true
  file = "${params.outdir}/execution_trace.txt"
  overwrite = true
}

timeline {
  enabled = true
  file = "${params.outdir}/execution_timeline.html"
  overwrite = true
}
